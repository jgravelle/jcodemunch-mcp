{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "jcodemunch",
  "displayName": "jCodeMunch",
  "version": "1.108.316",
  "description": "Token-efficient MCP server for source code exploration via tree-sitter AST parsing",
  "author": {
    "name": "J. Gravelle",
    "url": "https://github.com/jgravelle"
  },
  "homepage": "https://github.com/jgravelle/jcodemunch-mcp#readme",
  "repository": "https://github.com/jgravelle/jcodemunch-mcp",
  "license": "LicenseRef-jCodeMunch-Dual-Use-1",
  "keywords": [
    "code",
    "mcp",
    "tree-sitter",
    "ast",
    "token-efficiency",
    "code-search"
  ],
  "mcpServers": {
    "jcodemunch": {
      "command": "uvx",
      "args": [
        "jcodemunch-mcp"
      ]
    }
  }
}
