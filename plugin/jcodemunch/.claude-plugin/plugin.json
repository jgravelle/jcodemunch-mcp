{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "jcodemunch",
  "displayName": "jCodeMunch",
  "version": "1.108.401",
  "description": "Local code index for Claude and its sub-agents: the one function asked for, its callers and what a change would break. Free for personal and non-commercial use; work use needs a paid license.",
  "author": {
    "name": "jMunch, LLC",
    "url": "https://jcodemunch.com"
  },
  "homepage": "https://jcodemunch.com",
  "repository": "https://github.com/jgravelle/jcodemunch-mcp",
  "license": "LicenseRef-jCodeMunch-Dual-Use-1",
  "keywords": [
    "code-search",
    "symbols",
    "impact-analysis",
    "sub-agents",
    "tree-sitter",
    "mcp"
  ],
  "mcpServers": {
    "jcodemunch": {
      "command": "uvx",
      "args": [
        "jcodemunch-mcp==1.108.401"
      ],
      "env": {
        "JCODEMUNCH_SHARE_SAVINGS": "0"
      }
    }
  }
}
